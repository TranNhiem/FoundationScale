# Qwen3.6-35B-A3B - LoRA SFT at 16k context on 2x GB200 (measured peak at batch 1: 50.0 GB/GPU, see README)
MODEL=models/Qwen3.6-35B-A3B
CONTEXT=16384
DATASET=data/prepared/mixed.jsonl
OUTPUT_DIR=runs/gb200_Qwen3.6-35B-A3B_16k
# Qwen3.6 on GB200: batch 2 measured 6,276 vs 5,688 tokens/s (35B-A3B); GRAD_ACCUM=4 keeps the effective batch
BATCH=${BATCH:-2}
GRAD_ACCUM=${GRAD_ACCUM:-4}
