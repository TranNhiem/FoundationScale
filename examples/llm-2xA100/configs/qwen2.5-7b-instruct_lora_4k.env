# Qwen/Qwen2.5-7B-Instruct - LoRA r16/a32 SFT on UltraChat, 4K context, 2x A100-80GB (measured: see README)
MODEL=models/Qwen2.5-7B-Instruct
CONTEXT=4096
DATASET=data/llm/ultrachat_train.jsonl
OUTPUT_DIR=runs/qwen2.5-7b-instruct_lora_4k
# qwen2 has no FamilySpec in foundationscale.families.registry, so LoRA targets are named explicitly.
ADAPTER_TARGETS="q_proj k_proj v_proj o_proj gate_proj up_proj down_proj"
