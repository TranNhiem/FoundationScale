# Qwen2.5-7B-Instruct full fine-tune (SFT) on 2 Blackwell GPUs -- the SAME file drives both arms.
# train_nvfp4.sh takes the precision as its second argument, so the bf16 control and the NVFP4
# run can only differ by that one setting.
HF_MODEL=models/Qwen2.5-7B-Instruct          # HF checkpoint dir: tokenizer + conversion source
MEGATRON_CKPT=checkpoints/qwen2.5-7b         # written by convert_hf_to_megatron.py
RECIPE=qwen25_7b_sft_config                  # Megatron-Bridge library recipe
DATASET=squad                                # built-in preset (downloads itself); or local-jsonl
DATA_ROOT=                                   # local-jsonl only: dir with training.jsonl / validation.jsonl
NPROC=2                                      # GPUs on this node
TP=2                                         # tensor parallel (recipe default)
SEQ_LENGTH=2048
PAD_TO_MULTIPLE=128                          # pad each batch's length to this multiple (NVFP4 needs it; both arms)
GLOBAL_BATCH=32
MICRO_BATCH=1
STEPS=50
FP4_PARAM=false                              # nvfp4 arm: false = bf16 weights + FP4 GEMMs (fine-tuning); true = stock recipe
LR=5e-6
SEED=1234
OUTPUT_DIR=runs/qwen2.5-7b_sft
