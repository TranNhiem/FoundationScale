# Qwen/Qwen2-Audio-7B-Instruct - audio-LLM ASR LoRA fine-tune on LibriSpeech (measured: see README results table)
# LoRA (rank 16) covers the language model; the audio tower + multi_modal_projector train in FULL
# automatically (FoundationScale's qwen2_audio FamilySpec, automatic adapter-target scoping -- 224
# modules resolved with no --adapter-target flag needed; see chapter 03).
MODEL=models/Qwen2-Audio-7B-Instruct
DATASET=data/librispeech/manifests/train_full.jsonl
OUTPUT_DIR=runs/qwen2-audio-7b-lora
MODEL_KIND=audio_llm
ADAPTER=lora
: "${LR:=1e-4}"
: "${BATCH:=8}"
