# nvidia/parakeet-ctc-1.1b - CTC ASR full fine-tune on LibriSpeech (measured: see README results table)
MODEL=models/parakeet-ctc-1.1b
DATASET=data/librispeech/manifests/train_full.jsonl
OUTPUT_DIR=runs/parakeet-ctc-1.1b
MODEL_KIND=ctc
ADAPTER=
# Per-model tunables (shell env still overrides these -- ":=" only fills in when unset):
: "${LR:=5e-5}"
: "${WARMUP:=50}"
: "${BATCH:=4}"
