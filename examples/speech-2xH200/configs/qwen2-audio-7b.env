# Qwen/Qwen2-Audio-7B-Instruct - audio-LLM ASR FULL fine-tune on LibriSpeech (measured: see README results table)
MODEL=models/Qwen2-Audio-7B-Instruct
DATASET=data/librispeech/manifests/train_full.jsonl
OUTPUT_DIR=runs/qwen2-audio-7b
MODEL_KIND=audio_llm
ADAPTER=
: "${LR:=1e-5}"
: "${BATCH:=4}"
# Full fine-tune of 9.08B parameters needs sharded optimizer state to fit on 2x H200 under plain
# DDP replication (measured: OOMs at ~140 GiB/GPU without this). FSDP shards parameters, gradients
# and optimizer state across both GPUs instead of replicating them.
SHARDING=fsdp
# MEASURED on this VM, 2026-10-11: the default full-gather checkpoint save (--fsdp-state-dict full)
# fails FoundationScale's own checkpoint completeness gates for this model (RED, exit 5, no usable
# checkpoint). sharded passes those gates -- see scripts/train_speech.sh's FSDP_STATE_DICT comment
# and 03_training.md section 5 for what that trades away (tower_movement gate UNMEASURED, and a
# manual DCP-to-safetensors conversion needed before eval_wer.py can load the result).
FSDP_STATE_DICT=sharded
