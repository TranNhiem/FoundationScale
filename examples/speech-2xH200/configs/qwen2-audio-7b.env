# Qwen/Qwen2-Audio-7B-Instruct - audio-LLM ASR FULL fine-tune on LibriSpeech (measured: see README results table)
MODEL=models/Qwen2-Audio-7B-Instruct
DATASET=data/librispeech/manifests/train_full.jsonl
OUTPUT_DIR=runs/qwen2-audio-7b
MODEL_KIND=audio_llm
ADAPTER=
: "${LR:=1e-5}"
: "${BATCH:=4}"
# Full fine-tune of 9.08B parameters needs sharded optimizer state to fit on 2x H200 under plain
# DDP replication (measured: OOMs at ~140 GiB/GPU without this). FSDP shards parameters, gradients
# and optimizer state across both GPUs instead of replicating them.
SHARDING=fsdp
# full-gather checkpoint save, directly HF-loadable, tower_movement measured correctly (owner's fix,
# origin/main 152f43c, for the transformers>=5.18 on-disk-name mismatch that used to fail this save
# -- see scripts/train_speech.sh's FSDP_STATE_DICT comment and 03_training.md section 5). Set here
# explicitly even though it is also the CLI default, so the recipe is self-documenting.
FSDP_STATE_DICT=full
