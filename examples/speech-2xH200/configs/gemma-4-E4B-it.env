# google/gemma-4-E4B-it - audio-LLM ASR LoRA fine-tune on LibriSpeech (measured: see README results table)
# LoRA (rank 16) covers the language model; the audio tower + embed_audio projector train in FULL
# automatically (FoundationScale's gemma4 FamilySpec adapter_full_train -- not a flag you set here).
MODEL=models/gemma-4-E4B-it
DATASET=data/librispeech/manifests/train_full.jsonl
OUTPUT_DIR=runs/gemma-4-E4B-it
MODEL_KIND=audio_llm
ADAPTER=lora
: "${LR:=1e-4}"
: "${BATCH:=8}"
