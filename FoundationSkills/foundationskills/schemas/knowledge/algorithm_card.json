
{
  "type": "object",
  "description": "An algorithm the planner may select. Cards never claim runnability; the planner asks FS.",
  "required": ["name", "stage", "family", "data_format", "requires", "key_hparams", "failure_modes", "fs_entry", "references"],
  "additionalProperties": true,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["pretrain", "cpt", "sft", "preference", "rl"]},
    "family": {"type": "string", "enum": ["supervised", "preference", "group_rl", "actor_critic", "online"]},
    "data_format": {"type": "string", "enum": ["pretrain", "cpt", "sft", "preference", "rl", "mm_sft"]},
    "requires": {"type": "array", "items": {"type": "string", "enum": ["pairs", "gold_answers", "reward_fn", "reference_model", "critic"]}},
    "key_hparams": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["default", "range", "note"],
        "additionalProperties": true,
        "properties": {
          "range": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "note": {"type": "string"}
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symptom", "cause", "recovery"],
        "additionalProperties": true,
        "properties": {
          "symptom": {"type": "string", "minLength": 1},
          "cause": {"type": "string", "minLength": 1},
          "recovery": {"type": "string", "minLength": 1}
        }
      }
    },
    "fs_entry": {"type": "string", "enum": ["foundationscale-train", "fskills-rl"]},
    "references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
