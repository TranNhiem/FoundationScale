{
  "type": "object",
  "description": "High-level training goal produced by a planning skill.",
  "required": [
    "objective",
    "target_capabilities",
    "base_model",
    "data",
    "hardware",
    "preserve_general",
    "domain"
  ],
  "additionalProperties": true,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "target_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "preserve_general": {
      "type": "boolean"
    },
    "base_model": {
      "type": "object",
      "required": [
        "name_or_path"
      ],
      "additionalProperties": true,
      "properties": {
        "name_or_path": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string"
        },
        "size_b": {
          "type": "number",
          "minimum": 0
        },
        "arch": {
          "enum": [
            "dense",
            "moe"
          ]
        },
        "model_type": {
          "enum": [
            "llm",
            "vlm"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "sources"
      ],
      "additionalProperties": true,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "uri",
              "kind"
            ],
            "additionalProperties": true,
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "approx_tokens": {
                "type": "number",
                "minimum": 0
              },
              "approx_examples": {
                "type": "number",
                "minimum": 0
              },
              "domain": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "use_for": {
                "type": "array",
                "items": {
                  "enum": [
                    "pretrain",
                    "cpt",
                    "sft",
                    "preference",
                    "rl"
                  ]
                }
              },
              "answer_kind": {
                "enum": [
                  "mcq_letter",
                  "free_form"
                ]
              }
            }
          }
        }
      }
    },
    "hardware": {
      "type": "object",
      "required": [
        "gpu",
        "gpus_per_node",
        "nodes"
      ],
      "additionalProperties": true,
      "properties": {
        "gpu": {
          "type": "string",
          "minLength": 1
        },
        "gpus_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gpu_hours": {
          "type": "number",
          "minimum": 0
        },
        "deadline": {
          "type": "string"
        }
      }
    }
  }
}