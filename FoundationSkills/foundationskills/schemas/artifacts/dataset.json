
{
  "type": "object",
  "description": "Materialized dataset with FS column mapping.",
  "required": ["format", "shards", "schema", "num_records", "num_tokens", "tokenizer", "chat_template_family", "fs_columns"],
  "additionalProperties": true,
  "properties": {
    "format": {"enum": ["pretrain", "cpt", "sft", "preference", "rl", "mm_sft"]},
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "records"],
        "additionalProperties": true,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "records": {"type": "integer", "minimum": 0}
        }
      }
    },
    "schema": {
      "type": "object",
      "required": ["columns"],
      "additionalProperties": true,
      "properties": {
        "columns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "num_records": {"type": "integer", "minimum": 0},
    "num_tokens": {"type": ["integer", "null"]},
    "tokenizer": {"type": ["string", "null"]},
    "chat_template_family": {"type": ["string", "null"]},
    "fs_columns": {
      "type": "object",
      "required": ["text_column", "image_column", "gold_key"],
      "additionalProperties": true,
      "properties": {
        "text_column": {"type": ["string", "null"]},
        "image_column": {"type": ["string", "null"]},
        "gold_key": {"type": ["string", "null"]}
      }
    }
  }
}
