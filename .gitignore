.DS_Store

# Bytecode
__pycache__/
*.py[cod]
*$py.class

# Build artefacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.codegraph/

# Coverage
.coverage
.coverage.*
coverage.xml
# coverage.json is the report checks/coverage_floor.py adjudicates (#228). It is a
# build artifact like the rest of this block, and it is IN the repository tree, so
# leaving it untracked-and-unignored would put a generated file in front of every
# `git status` and every pre-push diff scan.
coverage.json
htmlcov/

# Editors
.idea/
.vscode/
*.swp
*.swo

# Local experiments — never commit
scratch/

# Training output. `python examples/train_tiny.py` writes out/train_tiny/ (two
# gated checkpoints, a final save and a run manifest) into whatever directory it
# is run from, which for the documented first run is this repo root. The
# hello-world must not dirty a public working tree.
out/

# Never commit the redaction mapping: it dereferences the public pseudonyms and
# would undo the point of publishing the audit with identifiers replaced.
*.private.json
redaction-map*

# Mutation-battery run output (regenerated per run, never committed)
artifacts/mutation-battery-report.json

# Measured by `make countables`; an oracle is never committed (#220).
.countables_census.json

# Graphify knowledge-graph output. The graph is built OUT of tree (GRAPHIFY_OUT is
# absolute, at ~/fs-graph/graphify-out) precisely so it stays out of the pre-push
# estate-scan denominator. This entry is the second, independent guard: graphify
# resolves its cache as <scan-root>/<GRAPHIFY_OUT>/cache/, so a run that forgets
# the env var writes ~8.5 MB / 210 files straight into this public repo.
graphify-out/

# #404: the mutation battery writes this while mutants are applied, so an
# interrupted run leaves it behind on purpose -- the next run reads it and
# refuses. It is transient recovery state, never a tracked artifact.
.mutate_in_flight.json
